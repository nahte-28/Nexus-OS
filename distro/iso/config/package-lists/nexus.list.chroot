# The NEXUS session (the NEXUS .deb itself comes from config/packages.chroot)
labwc
xwayland
foot
greetd
tuigreet
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
fonts-noto-core
fonts-noto-color-emoji
adwaita-icon-theme

# Sound, brightness, network, power
pipewire-audio
wireplumber
brightnessctl
network-manager
bluez
rfkill
wlr-randr
polkitd
pkexec
mate-polkit
upower

# Everyday apps that open as windows above NEXUS (more from Flathub in Linux-apps)
flatpak
firefox-esr
firefox-esr-l10n-nl
thunar
mousepad

# Hardware: drivers and firmware for wifi, graphics and sound on most laptops
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-sof-signed
intel-microcode
amd64-microcode
mesa-vulkan-drivers
libgl1-mesa-dri

# System (unattended-upgrades: Debian's security updates install by themselves every day)
unattended-upgrades
sudo
locales
console-setup
keyboard-configuration
ca-certificates
curl
apt-transport-https
live-config
live-config-systemd
# Creates the live user (a recommendation of live-config, which this build does not install by itself)
user-setup

# Boot splash with the NEXUS logo (theme made in hooks/normal/0200-nexus-branding)
plymouth
plymouth-themes
