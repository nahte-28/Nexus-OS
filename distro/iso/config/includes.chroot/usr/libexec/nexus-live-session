#!/bin/sh
# Live usb only: the session the live user is logged into at boot (see
# /usr/lib/live/config/2000-nexus-autologin). greetd starts it again when it stops, so right
# after boot a first start that stops at once is simply retried. But when NEXUS cannot start on
# this computer at all, that would flash the screen forever: after three short-lived starts in a
# row, show the login screen with an explanation instead. Logging in there tries again.
# Everything the session says goes to the system log (journalctl -b -t nexus-session), and
# the last lines are shown on that login screen.
tries=/tmp/nexus-live-tries
log=/tmp/nexus-live-session.log
n=$(cat "$tries" 2>/dev/null || echo 0)
if [ "$n" -ge 3 ] && [ -n "$GREETD_SOCK" ]; then
  rm -f "$tries"
  why=$(grep -v '^$' "$log" 2>/dev/null | tail -n 4 | cut -c1-160 | tr '\n' ' ')
  exec tuigreet --time --asterisks --cmd nexus-session \
    --greeting "NEXUS kon niet starten. Meld je aan als nexus (wachtwoord: live) om opnieuw te proberen. Laatste melding: ${why:-geen}"
fi
start=$(date +%s)
: > "$log"
NEXUS_SESSION_LOG="$log" nexus-session
status=$?
systemd-cat -t nexus-session cat "$log"
if [ $(( $(date +%s) - start )) -lt 15 ]; then
  echo $((n + 1)) > "$tries"
  echo "NEXUS-sessie stopte meteen (code $status), poging $((n + 1))" | systemd-cat -t nexus-session
  sleep 2
else
  rm -f "$tries"
fi
exit "$status"
