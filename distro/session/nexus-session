#!/bin/sh
# Starts the NEXUS session: the labwc compositor with NEXUS as the desktop.
# Chosen on the login screen as "NEXUS OS" (/usr/share/wayland-sessions/nexus.desktop).
export XDG_CURRENT_DESKTOP=NEXUS:wlroots
export XDG_SESSION_DESKTOP=NEXUS
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
# WebKitGTK stays blank on some graphics drivers and in VirtualBox without this.
export WEBKIT_DISABLE_DMABUF_RENDERER=1
# Without 3D graphics (most virtual machines, some older pc's) wlroots refuses the software
# renderer unless allowed; real graphics hardware is still preferred when it is there.
export WLR_RENDERER_ALLOW_SOFTWARE=1
# In a virtual machine (VirtualBox, QEMU) the mouse pointer stays invisible without this.
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then export WLR_NO_HARDWARE_CURSORS=1; fi
log() { command -v systemd-cat >/dev/null && echo "$*" | systemd-cat -t nexus-session; }
log "NEXUS-sessie start voor $(id -un)"
# Right after boot the graphics driver can still be loading; labwc stops at once without a
# screen, so wait for one (at most 15 seconds).
i=0
while ! ls /dev/dri/card* >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
  sleep 0.5
  i=$((i + 1))
done
ls /dev/dri/card* >/dev/null 2>&1 || log "Geen grafisch apparaat (/dev/dri) gevonden"
CONFIG=/usr/share/nexus-session/labwc
# Your own labwc settings in ~/.config/nexus-session win over the NEXUS defaults.
[ -d "$HOME/.config/nexus-session" ] && CONFIG="$HOME/.config/nexus-session"
# The live usb asks for the messages in a file too, to show them when NEXUS cannot start.
if [ -n "$NEXUS_SESSION_LOG" ]; then
  exec labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus >>"$NEXUS_SESSION_LOG" 2>&1
fi
# The session's messages go to the system log (journalctl -t nexus-session).
if command -v systemd-cat >/dev/null; then
  exec systemd-cat -t nexus-session labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus
fi
exec labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus
