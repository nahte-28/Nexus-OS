#!/bin/sh
# Starts the NEXUS session: the labwc compositor with NEXUS as the desktop.
# Chosen on the login screen as "NEXUS OS" (/usr/share/wayland-sessions/nexus.desktop).
export XDG_CURRENT_DESKTOP=NEXUS:wlroots
export XDG_SESSION_DESKTOP=NEXUS
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
# WebKitGTK stays blank on some graphics drivers and in VirtualBox without this.
export WEBKIT_DISABLE_DMABUF_RENDERER=1
# Without 3D graphics (most virtual machines, some older pc's) wlroots refuses the software
# renderer unless allowed; real graphics hardware is still preferred when it is there.
export WLR_RENDERER_ALLOW_SOFTWARE=1
# In a virtual machine (VirtualBox, QEMU) the mouse pointer stays invisible without this.
if command -v systemd-detect-virt >/dev/null && systemd-detect-virt -q; then export WLR_NO_HARDWARE_CURSORS=1; fi
log() { command -v systemd-cat >/dev/null && echo "$*" | systemd-cat -t nexus-session; }
log "NEXUS-sessie start voor $(id -un)"
# Right after boot the graphics driver can still be loading; labwc stops at once without a
# screen, so wait for one (at most 15 seconds).
i=0
while ! ls /dev/dri/card* >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
  sleep 0.5
  i=$((i + 1))
done
ls /dev/dri/card* >/dev/null 2>&1 || log "Geen grafisch apparaat (/dev/dri) gevonden"
CONFIG=/usr/share/nexus-session/labwc
# Your own labwc settings in ~/.config/nexus-session win over the NEXUS defaults.
[ -d "$HOME/.config/nexus-session" ] && CONFIG="$HOME/.config/nexus-session"
# Starts labwc once; the messages go to the live usb's file, or to the system log
# (journalctl -t nexus-session).
run_labwc() {
  if [ -n "$NEXUS_SESSION_LOG" ]; then
    labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus >>"$NEXUS_SESSION_LOG" 2>&1
  elif command -v systemd-cat >/dev/null; then
    systemd-cat -t nexus-session labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus
  else
    labwc -C "$CONFIG" -s /usr/lib/nexus-session/keep-nexus
  fi
}
start=$(date +%s)
status=0
# Test hook (boot option nexus.nogl, used by distro/iso/smoke.sh): the first start cannot make
# a renderer, like VirtualBox without 3D acceleration, so the fallback below gets exercised.
if grep -qw nexus.nogl /proc/cmdline 2>/dev/null; then
  log "Test nexus.nogl: eerste start zonder renderer"
  (export WLR_RENDERER=nexus-nogl; run_labwc) || status=$?
else
  run_labwc || status=$?
fi
# Graphics that cannot draw with the graphics card (VirtualBox without 3D acceleration, some
# older pc's: "Failed to initialize EGL context") stop labwc at once. Then start again with
# drawing done by the processor only: slower, but NEXUS opens.
if [ $(( $(date +%s) - start )) -lt 10 ] && [ -z "${WLR_RENDERER:-}" ]; then
  log "labwc stopte meteen (code $status): opnieuw zonder grafische versnelling"
  export WLR_RENDERER=pixman
  export LIBGL_ALWAYS_SOFTWARE=1
  [ -n "$NEXUS_SESSION_LOG" ] && echo "Opnieuw zonder grafische versnelling" >>"$NEXUS_SESSION_LOG"
  status=0
  run_labwc || status=$?
fi
exit "$status"
