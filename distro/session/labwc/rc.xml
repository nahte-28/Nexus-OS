<?xml version="1.0"?>
<!-- labwc settings for the NEXUS session. NEXUS fills the screen as the desktop; Linux apps
     open as normal windows on top of it. -->
<labwc_config>
  <core>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow" name="sans" size="10" />
  </theme>
  <placement>
    <policy>center</policy>
  </placement>
  <keyboard>
    <default />
    <!-- Super+Space brings NEXUS to the front (a second start shows the running NEXUS). -->
    <keybind key="W-space"><action name="Execute" command="nexus-desktop" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="x-terminal-emulator" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set 5%+" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
  </keyboard>
  <windowRules>
    <!-- NEXUS draws its own window; no title bar from labwc. -->
    <windowRule identifier="nexus-desktop" serverDecoration="no" />
    <windowRule identifier="app.nexusos.desktop" serverDecoration="no" />
  </windowRules>
</labwc_config>
