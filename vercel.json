{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai.ts": {
      "maxDuration": 60
    },
    "api/study.ts": {
      "maxDuration": 60
    },
    "api/review.ts": {
      "maxDuration": 60
    },
    "api/cards.ts": {
      "maxDuration": 60
    }
  }
}
