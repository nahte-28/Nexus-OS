{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS OS",
  "version": "0.8.0",
  "identifier": "app.nexusos.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @nexus/web",
    "beforeBuildCommand": "npm run build -w @nexus/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXUS OS",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://nexus-os-lime.vercel.app; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "NEXUS OS",
    "longDescription": "Een modulair, persoonlijk ecosysteem voor web, Windows, Android en smartwatch.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["Dutch"],
        "installMode": "currentUser"
      }
    }
  }
}
